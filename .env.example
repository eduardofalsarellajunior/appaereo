# Frontend (Vite) — expostas ao browser, use apenas chaves públicas/anon
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# --- Segredos de servidor — NUNCA prefixar com VITE_, nunca expor ao browser ---

# Usado por scripts locais (scripts/) e por psql para rodar SQL diretamente no banco.
# Settings > Database > Connection string (modo "Transaction" / pooler), no painel do Supabase.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Usado pela Supabase Edge Function (configurar via `supabase secrets set`, não aqui).
DUFFEL_API_KEY=duffel_test_xxxxxxxxxxxxxxxxxxxxxxxxx

# service_role key da Edge Function para gravar em price_history (configurar via `supabase secrets set`).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
